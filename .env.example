# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/issue-tracker

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here

# Access token expiry duration (short-lived; default: 15m)
JWT_EXPIRES_IN=15m

# Refresh token signing secret (generate separately: openssl rand -hex 32)
# If not set, falls back to JWT_SECRET (not recommended in production)
REFRESH_TOKEN_SECRET=your-refresh-secret-key-here

# Refresh token expiry duration (long-lived; default: 7d)
REFRESH_EXPIRES_IN=7d
